{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/three-way-debate",
        "function": {
          "functionId": "generateThreeWayDebate",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "site": "orqube-576e7"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci --no-audit --no-fund",
        "npm --prefix \"$RESOURCE_DIR\" run check"
      ]
    },
    {
      "source": "functions_ai",
      "codebase": "ai",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci --no-audit --no-fund",
        "npm --prefix \"$RESOURCE_DIR\" run check"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
