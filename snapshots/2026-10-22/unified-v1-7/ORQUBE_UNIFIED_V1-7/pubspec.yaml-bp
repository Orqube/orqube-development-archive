name: orqube_app
description: ORQUBE Mining App V6 Final - Web3 mining, Firebase login, AdMob reward, Google Play ready.
publish_to: "none"

version: 1.0.0+1

environment:
  sdk: ">=3.7.0 <4.0.0"

dependencies:
  flutter:
    sdk: flutter

  cupertino_icons: ^1.0.8

  firebase_core: ^3.15.1
  firebase_auth: ^5.6.2
  cloud_firestore: ^5.6.11
  google_sign_in: ^6.3.0

  google_mobile_ads: ^9.0.0
  flutter_map: ^8.1.1
  latlong2: ^0.9.1
  geolocator: ^13.0.4
  http: ^1.2.2
  url_launcher: ^6.3.1
  pdfrx: ^2.4.7

dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true

  assets:
  - assets/images/
  - assets/images/logo/
  - assets/images/nft/
  - assets/images/icons/
  - assets/images/background/
  - assets/nft/
  - assets/images/nft/
  - assets/images/brand/
  - assets/icons/
  - assets/sounds/
  - assets/animation/
  - assets/docs/
